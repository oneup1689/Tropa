<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: cloud backup and phone-to-phone transfer copy only the walks database (and only when the
     person switched it on in the settings, see TropaBackupAgent). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="tropa.db"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="tropa.db"/>
    </device-transfer>
</data-extraction-rules>
